{
    auto_https off
}
http://api.{$DOMAIN:tradingweb.local} {
    reverse_proxy api:8000
}
http://admin.{$DOMAIN:tradingweb.local} {
    reverse_proxy admin:3000
}
http://app.{$DOMAIN:tradingweb.local} {
    @homeAssets path /hero.css /sections.css /market.js /language.js /animations.js
    handle @homeAssets {
        root * /srv/home
        file_server
    }
    handle /market-data {
        rewrite * /api/market/landing
        reverse_proxy api:8000
    }
    handle / {
        root * /srv/home
        rewrite * /index.html
        file_server
    }
    handle {
        reverse_proxy web:3000
    }
}
