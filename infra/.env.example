# Copy to infra/.env. Local demo only; never commit the generated file.
# Domain routed by Caddy; local HTTP deliberately has no public TLS requirement.
DOMAIN=tradingweb.local
HTTP_PORT=8080
API_PORT=8000
# Database credentials (URL-safe values; generate locally).
POSTGRES_USER=tradingweb
POSTGRES_DB=tradingweb_demo
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_VALUE
# Compose derives DATABASE_URL and REDIS_URL for the API container.
# Direct host development: use reachable PostgreSQL and Redis endpoints.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tradingweb_demo
# REDIS_URL=redis://localhost:6379/0
# DEMO_MODE is pinned true by Compose and defaults true in every app.
DEMO_MODE=true
# Generate at least 32 random bytes, e.g. python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALG=HS256
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Shared development password for synthetic accounts; at least 12 characters.
SEED_PASSWORD=REPLACE_WITH_DEVELOPMENT_PASSWORD
# Unsupported in phase 1: live mode remains disabled even if a key is present.
# LIVE_LICENSE_KEY=
